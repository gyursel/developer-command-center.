{
  "name": "developer-command-center",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "developer-command-center",
      "database_id": "b4eacd44-7a5e-4284-8d9a-07858849da3d",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "10 * * * *"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://developer-command-center.peter200419.workers.dev",
    "OWNER_USERNAME": "admin"
  },
  "workers_dev": true
}
